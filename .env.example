# -------------------------------------------------------
# BOARDS-AI Mock Simulator — Environment Variables
# -------------------------------------------------------
# Copy this file to .env and fill in your API key(s).
#
# At minimum, you need:
#   - OPENROUTER_API_KEY to run live models
#   - Or provide the key at runtime via the sidebar
#
# You can specify and use any model from:
#   https://openrouter.ai/models
# -------------------------------------------------------

OPENROUTER_API_KEY=sk-or-v1-your-key-here

